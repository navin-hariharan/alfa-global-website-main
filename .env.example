# Copy this file to .env and fill in the values. Never commit .env.

# NocoDB server, without a trailing slash (for example https://nocodb.example.com)
NOCODB_URL=
# NocoDB API token (sent as the xc-token header)
NOCODB_API_TOKEN=

# Base and table ids (defaults match the current Team and Services tables)
NOCODB_BASE_ID=p1uzmrjrxr8s8x9
NOCODB_TEAM_TABLE=mly0l1dxwu1role
NOCODB_SERVICES_TABLE=moaw8ss95jywuuy
# 0 = read NocoDB live on every page view. Raise it (e.g. 30) to cache briefly.
NOCODB_CACHE_SECONDS=0

# Public address of the site, used for canonical links and the sitemap
SITE_URL=https://alfaglobalwealth.com

# Port published on the host by docker compose
HOST_PORT=8080
